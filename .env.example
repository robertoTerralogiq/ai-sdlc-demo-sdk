# Copy to .env and fill in for local runs. .env is gitignored. Do not commit a filled-in copy.
#
# The CLI picks up the nearest .env at or above the working directory. Values already
# in the real environment are never overwritten, so in Actions the workflow's env wins.

# --- required ---

# owner/name of the repo holding the PR.
GITHUB_REPOSITORY=

# Fine-grained PAT for local runs: Pull requests read/write, Contents read.
# In Actions the built-in GITHUB_TOKEN is used instead.
GITHUB_TOKEN=

# Google AI Studio key: https://aistudio.google.com/apikey
# Leave empty if you use Vertex AI instead, see the optional block below.
GEMINI_API_KEY=

# --- optional ---

# PR to review. Usually passed per run with --pr instead.
# REVIEW_PR_NUMBER=42
# GitHub Enterprise Server: GITHUB_API_URL=https://ghe.example.com/api/v3

# GEMINI_MODEL=gemini-2.5-pro
# REVIEW_FAIL_ON=blocker
# REVIEW_MIN_CONFIDENCE=0.6
# REVIEW_DRY_RUN=true

# Vertex AI instead of an API key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
